{
	"name": "Floci DooD setup",
	"dockerComposeFile": [
		"../docker/networks.yml",
		"../docker/infrastructure.yml",
		"../docker/dev-tools.yml",
		"devcontainer.yml"
	],
	"service": "cap-xml",
	"workspaceFolder": "/opt/workspaces/${localWorkspaceFolderBasename}",
	// Features to add to the Dev Container. More info: https://containers.dev/implementors/features.
	"features": {
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
			"upgradePackages": true
		},
		"ghcr.io/devcontainers/features/aws-cli:1": {}
	},
	"customizations": {
		"vscode": {
			// Add the IDs of extensions you want installed when the container is created.
			"extensions": [
				"GitHub.copilot",
				"standard.vscode-standard"
			]
		}
	},
	"initializeCommand": "docker/scripts/initialize-command.sh",
	"postCreateCommand": "(cd ${containerWorkspaceFolder} && docker/scripts/post-create-command.sh)"
}